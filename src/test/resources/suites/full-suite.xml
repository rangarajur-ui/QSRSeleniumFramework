<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Full suite (sanity + regression + e2e).
  Sequential on purpose: all UI tests share one table QR / session.
-->
<suite name="QSR-FullSuite" verbose="1">

    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="Sanity">
        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>
        <classes>
            <class name="tests.CatalogApiHealthTest"/>
            <class name="tests.LandingPageTest"/>
            <class name="tests.CatalogPageTest"/>
            <class name="tests.CustomerDetailsTest"/>
            <class name="tests.PaymentSummaryTest"/>
        </classes>
    </test>

    <test name="Regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="tests.CatalogPageTest"/>
            <class name="tests.CustomerDetailsTest"/>
            <class name="tests.PaymentSummaryTest"/>
            <class name="tests.CatalogApiTest"/>
            <class name="tests.FullOrderFlowTest"/>
        </classes>
    </test>
</suite>
